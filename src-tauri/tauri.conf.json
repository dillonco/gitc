{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitc",
  "version": "0.1.0",
  "identifier": "dev.dillon.gitc",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gitc",
        "width": 1320,
        "height": 860,
        "minWidth": 1060,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": []
  }
}
