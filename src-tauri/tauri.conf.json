{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kGit",
  "version": "../package.json",
  "identifier": "dev.dillon.kgit",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kGit",
        "width": 1320,
        "height": 860,
        "minWidth": 1060,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A small-footprint desktop git client",
    "copyright": "Copyright © 2026 Dillon",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQ0U4M0U1NjZDQjhGNkMKUldSc2o4dG01WVBPTTlXOGltNWRxNXk3dmhyQk8xK1pkNVgrRE5idk9HVWlza3dSVHMwOWtQQkEK",
      "endpoints": [
        "https://github.com/dillonco/kgit/releases/latest/download/latest.json"
      ]
    }
  }
}
